# ============================================================
# Group Expense Splitter — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ============================================================

# ──────────────────────────────────────────────
# MongoDB
# ──────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
# Use separate DB names for dev and prod:
MONGODB_DB_NAME=group_expense_dev
# Production: MONGODB_DB_NAME=group_expense_prod

# ──────────────────────────────────────────────
# JWT Authentication
# ──────────────────────────────────────────────
# Generate a secure secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=10080

# ──────────────────────────────────────────────
# Application
# ──────────────────────────────────────────────
APP_NAME="Group Expense Splitter"
APP_VERSION="2.0.0"
DEBUG=true

# ──────────────────────────────────────────────
# AI / Gemini
# ──────────────────────────────────────────────
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# ──────────────────────────────────────────────
# Email (optional — set MAIL_ENABLED=true when configured)
# ──────────────────────────────────────────────
MAIL_ENABLED=false
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=noreply@expensesplitter.app
MAIL_FROM_NAME="Group Expense Splitter"
MAIL_STARTTLS=true
MAIL_SSL_TLS=false

# ──────────────────────────────────────────────
# CORS / URLs
# ──────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
FRONTEND_URL=http://localhost:5173
