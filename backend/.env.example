# Backend Environment Variables — EXAMPLE FILE
# Copy this to .env and fill in your real values.
# NEVER commit .env to version control.

# ============================================================
# Database
# ============================================================
# SQLite (default for development)
DATABASE_URL=sqlite:///./expense_splitter.db

# PostgreSQL (for production — uncomment and fill in)
# DATABASE_URL=postgresql://user:password@localhost:5432/expense_splitter

# ============================================================
# Application
# ============================================================
APP_NAME="Group Expense Splitter"
APP_VERSION="1.0.0"
DEBUG=true

# ============================================================
# AI / Gemini
# ============================================================
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use
GEMINI_MODEL=gemini-2.0-flash

# ============================================================
# CORS (allowed origins for frontend)
# ============================================================
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
